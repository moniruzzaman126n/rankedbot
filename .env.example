# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to GitHub.

DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here

# Optional: set this while testing so slash commands register instantly
# to one server instead of taking up to an hour to show up globally.
GUILD_ID=your-test-server-id-here

# Optional: only needed if you deploy on a host that requires an open
# HTTP port (like Render's free Web Service). Leave blank otherwise.
PORT=3000
